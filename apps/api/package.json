{
	"name": "@apps/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"prebuild": "pnpm run lint",
		"build": "tsgo --build && tsgo --noEmit --project tsconfig.rolldown.json && rolldown -c rolldown.config.ts && cellix-prepare-func-deploy && node ../../scripts/zip-azure-functions.mjs",
		"typecheck": "tsgo --build --pretty false",
		"dev": "pnpm exec portless api.agentcourses.localhost --force node --watch start-dev.ts",
		"dev:worktree": "pnpm exec portless api.agentcourses.${WORKTREE_NAME}.localhost --force node --watch start-dev.ts",
		"prepare:deploy": "cellix-prepare-func-deploy",
		"watch": "tsgo --watch",
		"test": "vitest run --silent --reporter=dot",
		"test:watch": "vitest",
		"format": "biome format --write",
		"format:check": "biome format .",
		"lint": "biome lint",
		"clean": "rimraf dist deploy",
		"start": "func start --typescript --script-root deploy/"
	},
	"dependencies": {
		"@axc/application-services": "workspace:*",
		"@axc/domain": "workspace:*",
		"@axc/persistence": "workspace:*",
		"@axc/rest": "workspace:*",
		"@axc/service-mongoose": "workspace:*",
		"@azure/functions": "catalog:",
		"@hono/node-server": "^1.19.5",
		"@marplex/hono-azurefunc-adapter": "^1.0.0",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@cellix/config-rolldown": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"@cellix/config-vitest": "workspace:*",
		"@vitest/coverage-istanbul": "catalog:",
		"rimraf": "catalog:",
		"rolldown": "1.0.0-beta.55",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
