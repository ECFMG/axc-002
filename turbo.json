{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": ["WORKTREE_NAME", "AXC_ENVIRONMENT", "NODE_ENV", "PORT", "MONGODB_URI", "SNYK_TOKEN", "MONGOMS_SYSTEM_BINARY"],
	"futureFlags": {
		"affectedUsingTaskInputs": true,
		"watchUsingTaskInputs": true
	},
	"tasks": {
		"build": {
			"description": "Compiles TypeScript and bundles each package",
			"dependsOn": ["^build"],
			"inputs": [
				"src/**/*.ts",
				"src/**/*.tsx",
				"src/**/*.mts",
				"src/**/*.cts",
				"src/**/*.js",
				"src/**/*.jsx",
				"src/**/*.json",
				"tsconfig*.json",
				"rolldown.config.ts",
				"!coverage/**",
				"!target/**",
				"!tests/**",
				"!**/*.test.*",
				"!**/*.spec.*",
				"!vitest*.config.*"
			],
			"outputs": ["dist/**", "build/**", "deploy/**", "*.tsbuildinfo"]
		},
		"typecheck": {
			"description": "Typechecks each package with TypeScript 6 / tsgo",
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
		},
		"test": {
			"description": "Runs the default unit/integration test suite for each package",
			"dependsOn": ["^build", "@cellix/config-vitest#build"],
			"inputs": ["$TURBO_DEFAULT$", "**/*.test.ts", "!coverage/**", "!target/**", "!dist/**", "!build/**", "!deploy/**"]
		},
		"test:arch": {
			"description": "Runs architecture unit tests",
			"dependsOn": ["build", "^build", "@cellix/config-vitest#build", "@cellix/archunit-tests#build"],
			"inputs": ["$TURBO_DEFAULT$", "src/**/*.test.ts", "!coverage/**", "!target/**", "!dist/**", "!build/**", "!deploy/**"]
		},
		"test:acceptance": {
			"description": "Runs Serenity/Cucumber acceptance tests",
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "**/*.feature", "!coverage/**", "!target/**", "!dist/**", "!build/**", "!deploy/**"],
			"outputs": ["target/**", "reports/**"],
			"cache": false
		},
		"start": {
			"description": "Starts the built API in Azure Functions-compatible local runtime mode",
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"dev": {
			"description": "Starts application packages in watch mode behind Portless",
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"dev:worktree": {
			"description": "Starts dev servers with worktree-scoped Portless hostnames",
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"description": "Runs the Biome linter",
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json", "!coverage/**", "!target/**", "!dist/**", "!build/**", "!deploy/**"],
			"outputs": []
		},
		"format": {
			"description": "Formats source files with Biome",
			"outputs": []
		},
		"format:check": {
			"description": "Checks source formatting with Biome without writing changes",
			"outputs": []
		},
		"clean": {
			"description": "Removes generated build artifacts and caches",
			"cache": false,
			"outputs": []
		},
		"//#knip": {
			"description": "Finds unused files, exports, and dependencies",
			"cache": false
		},
		"//#e18e": {
			"description": "Runs @e18e/cli analyze for dependency modernization",
			"cache": false
		},
		"//#audit": {
			"description": "Runs pnpm audit",
			"cache": false
		},
		"//#snyk": {
			"description": "Runs Snyk CLI locally (skipped without credentials on first scaffold)",
			"cache": false
		},
		"//#check-scripts": {
			"description": "Enforces the no-dependency-lifecycle-scripts policy",
			"cache": false
		}
	}
}
