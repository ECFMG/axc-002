{
	"name": "@axc/service-mongoose",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"typecheck": "tsgo --build --pretty false",
		"prebuild": "pnpm run lint",
		"build": "tsgo --build",
		"watch": "tsgo --watch",
		"test": "vitest run --silent --reporter=dot",
		"test:watch": "vitest",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@cellix/api-services-spec": "workspace:*",
		"@cellix/mongoose-seedwork": "workspace:*",
		"mongoose": "catalog:"
	},
	"devDependencies": {
		"@cellix/config-typescript": "workspace:*",
		"@cellix/config-vitest": "workspace:*",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
