{
	"name": "@axc-verification/archunit-tests",
	"version": "1.0.0",
	"description": "Architectural fitness tests for agentCourses",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./domain": "./src/domain.ts"
	},
	"scripts": {
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"typecheck": "tsgo --noEmit --pretty false",
		"test": "vitest run",
		"test:arch": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@cellix/archunit-tests": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"@cellix/config-vitest": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
